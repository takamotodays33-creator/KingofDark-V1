-- ═══════════════════════════════════════════════════════════════
local Visual = { espEnabled = false, fullbright = false, espColor = Color3.fromRGB(230, 40, 55) }
local ESP_Objects = {}

do
    local sec = Tabs.visual.section("ESP", "Caixa ao redor dos jogadores")

    Components.toggle(sec, {
        text = "ESP Ativado",
        default = false,
        callback = function(v)
            Visual.espEnabled = v
            if not v then
                for _, obj in pairs(ESP_Objects) do
                    if obj.hl then obj.hl:Destroy() end
                end
                ESP_Objects = {}
            end
        end,
    })

    Components.colorpicker(sec, {
        text = "Cor do ESP",
        default = Color3.fromRGB(230, 40, 55),
        callback = function(c) Visual.espColor = c end,
    })

    local sec2 = Tabs.visual.section("ILUMINAÇÃO", nil)
    Components.toggle(sec2, {
        text = "Fullbright",
        default = false,
        callback = function(v)
            Visual.fullbright = v
            if v then
                Lighting.Brightness = 3
                Lighting.ClockTime = 14
                Lighting.GlobalShadows = false
            else
                Lighting.Brightness = 2
                Lighting.GlobalShadows = true
            end
        end,
    })
end

LoopManager.start("espLoop", function()
    if not Visual.espEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not ESP_Objects[p] then
            local hl = Instance.new("Highlight")
            hl.FillColor = Visual.espColor
            hl.FillTransparency = 0.7
            hl.OutlineColor = Visual.espColor
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = p.Character
            hl.Parent = ScreenGui
            ESP_Objects[p] = { hl = hl }
        end
        if ESP_Objects[p] and ESP_Objects[p].hl then
            ESP_Objects[p].hl.Adornee = p.Character
            ESP_Objects[p].hl.FillColor = Visual.espColor
            ESP_Objects[p].hl.OutlineColor = Visual.espColor
        end
    end
end, 0.3)

