--  [25] LOOP MANAGER
-- ═══════════════════════════════════════════════════════════════
local LoopManager = { loops = {} }
function LoopManager.start(key, fn, interval)
    if LoopManager.loops[key] then LoopManager.stop(key) end
    interval = interval or 0.1
    local running = true
    LoopManager.loops[key] = { stop = function() running = false end }
    task.spawn(function()
        while running and ScreenGui.Parent do
            local ok, err = pcall(fn)
            if not ok then warn("[KingOfDark] Loop '" .. key .. "': " .. tostring(err)) end
            task.wait(interval)
        end
        LoopManager.loops[key] = nil
    end)
end
function LoopManager.stop(key)
    if LoopManager.loops[key] then
        LoopManager.loops[key].stop()
        LoopManager.loops[key] = nil
    end
end

