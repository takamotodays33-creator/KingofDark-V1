--  [28] ABA PRINCIPAL
-- ═══════════════════════════════════════════════════════════════
local FeatureState = {
    autoFarm = false, autoFarmRange = 30,
    autoCollect = false, killAura = false, killAuraRange = 15,
}

do
    local sec = Tabs.principal.section("AUTO-FARM", "Yen, hits e coleta automática")

    Components.toggle(sec, {
        text = "Auto-Farm Yen / Hits",
        desc = "Teletransporta até o alvo mais próximo",
        default = false,
        callback = function(v)
            FeatureState.autoFarm = v
            if v then
                LoopManager.start("autoFarm", function()
                    local t = Target.nearest()
                    if t and t.distance <= FeatureState.autoFarmRange then
                        tpBehind(t.hrp, 4)
                        local tool = U.getChar():FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end
                end, 0.15)
                Notification.push("Auto-Farm", "Ativado", "Success", 2)
            else
                LoopManager.stop("autoFarm")
                Notification.push("Auto-Farm", "Desativado", "Warning", 2)
            end
        end,
    })

    Components.slider(sec, {
        text = "Raio de Farm", min = 5, max = 150, default = 30, suffix = " std",
        callback = function(v) FeatureState.autoFarmRange = v end,
    })

    Components.toggle(sec, {
        text = "Auto-Coletar Yen",
        default = false,
        callback = function(v)
            FeatureState.autoCollect = v
            if v then
                LoopManager.start("autoCollect", function()
                    local hrp = U.getHRP()
                    if not hrp then return end
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("yen") or obj.Name:lower():find("coin")) then
                            if (obj.Position - hrp.Position).Magnitude < 80 then
                                hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 3, 0))
                                return
                            end
                        end
                    end
                end, 0.35)
            else
                LoopManager.stop("autoCollect")
            end
        end,
    })

    local sec2 = Tabs.principal.section("TELEPORTE", nil)
    Components.button(sec2, {
        text = "Ir para o Mais Próximo", icon = "↯", style = "primary",
        callback = function()
            local t = Target.nearest()
            if t then
                tpBehind(t.hrp, 4)
                Notification.push("TP", "Movido até " .. t.player.Name, "Success", 2)
            end
        end,
    })
end

