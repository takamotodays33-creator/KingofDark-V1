    local stroke = Instance.new("UIStroke")
    stroke.Color = T.Border
    stroke.Thickness = 1
    stroke.Transparency = 0.7
    stroke.Parent = row

    local label = Instance.new("TextLabel")
    label.Text = text
    label.Font = FONT_MED
    label.TextSize = 13
    label.TextColor3 = T.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Size = UDim2.new(1, -80, 0, desc and 18 or 44)
    label.Position = UDim2.new(0, 14, 0, desc and 8 or 0)
    label.BackgroundTransparency = 1
    label.Parent = row

    if desc then
        local d = Instance.new("TextLabel")
        d.Text = desc
        d.Font = FONT
        d.TextSize = 10
        d.TextColor3 = T.TextMuted
        d.TextXAlignment = Enum.TextXAlignment.Left
        d.Size = UDim2.new(1, -80, 0, 14)
        d.Position = UDim2.new(0, 14, 0, 28)
        d.BackgroundTransparency = 1
        d.Parent = row
    end

    local state = default

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 46, 0, 24)
    track.Position = UDim2.new(1, -58, 0.5, -12)
    track.BackgroundColor3 = state and T.Accent or T.GlassHi
    track.BorderSizePixel = 0
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = state and UDim2.new(0, 25, 0, 3) or UDim2.new(0, 3, 0, 3)
    knob.BackgroundColor3 = Color3.fromRGB(245, 245, 252)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton")
    btn.Text = ""
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Parent = row

    local function setState(v, silent)
        state = v
        U.tw(track, 0.2, { BackgroundColor3 = state and T.Accent or T.GlassHi })
        U.tw(knob, 0.2, { Position = state and UDim2.new(0, 25, 0, 3) or UDim2.new(0, 3, 0, 3) })
        if not silent and onChange then U.safe(onChange, state) end
    end

    btn.MouseButton1Click:Connect(function() setState(not state) end)

    return { frame = row, get = function() return state end, set = function(v) setState(v, true) end }
end

